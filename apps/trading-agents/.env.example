# Copy to .env in this directory. Never commit real keys.
# The desk uses the provider selected in the form. Only that provider's key
# is required for a live run. With no key, Run plays the shipped sample.

XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Required for unscoped Anthropic keys (send anthropic-workspace-id).
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
GOOGLE_API_KEY=

# Optional. US macro indicators are skipped when this is unset.
# India mode does not call FRED. It uses Yahoo series plus the static note in sidecar/india/rbi_note.py.
# FRED_API_KEY=

# Optional. SEC EDGAR has no key. Set a contact address so SEC can reach you.
# SEC_EDGAR_USER_AGENT=your-name you@example.com
