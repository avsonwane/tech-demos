# Copy to .env in this directory. Never commit real keys.
# With no key, Ask the agent plays the shipped illustrative sample.
# The chart, packet, and Reality check do not need a key.

# Ports. trading-agents / kronos use 8000 / 5173 and vibe-trading uses 8010 / 5174.
DESK_PORT=8011
VITE_PORT=5175

# Desk default: claude-sonnet-5-5. The page can also pick claude-opus-5-5
# or claude-fable-5-2. Opus and Fable cost several times more than Sonnet.
# ANTHROPIC_MODEL overrides the default. A model chosen on the page wins
# for that request. Claude 5 models are not sent temperature, top_p, or top_k.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional. Unscoped Anthropic keys need this. The desk sends it as
# the anthropic-workspace-id header.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
