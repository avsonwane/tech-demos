# Copy to .env in this directory. Never commit real keys.
# The desk uses the provider selected on the page. Only that provider's key
# is required for a live session. With no key, Run plays the shipped sample.

# xAI has no catalog entry in vibe-trading-ai 0.1.19. The desk points the
# OpenAI-compatible client at https://api.x.ai/v1 and sends grok-4.6.
XAI_API_KEY=

# Catalog default model: gpt-5.5
OPENAI_API_KEY=

# Desk model: claude-sonnet-5-5 (the 0.1.19 catalog default is claude-sonnet-4-6).
# Non-default temperature, top_p, and top_k are dropped for this model.
ANTHROPIC_API_KEY=
# Optional. Unscoped Anthropic keys need this. The desk sends it as
# the anthropic-workspace-id header.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
