# Copy to .env in this directory. Never commit real keys.
# The desk uses the provider selected on the page. Only that provider's key
# is required for a live session. With no key, Run plays the shipped sample.

# Ports. apps/trading-agents already binds 8000 and 5173, so this desk
# defaults to 8010 and 5174. If a port is taken, bun run dev stops and
# prints: lsof -ti tcp:<port> | xargs kill
DESK_PORT=8010
VITE_PORT=5174
VIBE_PORT=8899

# xAI has no catalog entry in vibe-trading-ai 0.1.19. The desk points the
# OpenAI-compatible client at https://api.x.ai/v1 and sends grok-4.6.
XAI_API_KEY=

# Catalog default model: gpt-5.5
OPENAI_API_KEY=

# Desk default: claude-sonnet-5-5. The page can also pick claude-opus-5-5
# or claude-fable-5-2. Opus and Fable cost several times more than Sonnet.
# ANTHROPIC_MODEL overrides the default. A model chosen on the page wins
# for that run. Claude 5 models are not sent temperature, top_p, or top_k.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional. Unscoped Anthropic keys need this. The desk sends it as
# the anthropic-workspace-id header.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
